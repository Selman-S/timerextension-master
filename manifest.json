{
  "manifest_version": 3,
  "name": "Hyperactive Pro Time Enhancer",
  "version": "4.1.3",
  "description": "Time sayfasında timer queue ve kişisel billable pulse.",
  "permissions": ["storage", "activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["https://hyperactive.pro/*"],
      "js": [
        "queue-manager.js",
        "queue-core.js",
        "queue-ui-1.js",
        "queue-ui-2.js",
        "queue-ui-3.js",
        "queue-ui.js",
        "my-pulse.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
